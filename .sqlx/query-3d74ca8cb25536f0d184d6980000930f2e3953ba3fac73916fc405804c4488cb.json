  "query": "SELECT l.at AS \"at: DateTime<Utc>\", u.display_name AS person, l.name, l.detail\n           FROM command_log l JOIN users u ON u.id = l.user_id\n           WHERE l.ok = 0 AND l.kind != 'unknown'\n             AND (?1 IS NULL OR datetime(l.at) >= datetime(?1))\n           ORDER BY l.at DESC\n           LIMIT ?2",
