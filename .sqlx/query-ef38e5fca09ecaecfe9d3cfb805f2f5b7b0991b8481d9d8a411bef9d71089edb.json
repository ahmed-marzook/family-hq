  "query": "SELECT r.id, c.wa_chat_id, r.source, r.text, r.mentions\n           FROM reminders r\n           JOIN chats c ON c.id = r.chat_id\n           WHERE r.claimed_at IS NULL AND c.left_at IS NULL\n             AND datetime(r.due_at) <= datetime(?)\n           ORDER BY datetime(r.due_at), r.id",
