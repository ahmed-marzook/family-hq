# Serves the admin dashboard's files and passes /api on to family-hq, so the
# browser only ever talks to this one address.
{
	# No admin endpoint, no certificates (TLS, if wanted, comes from
	# `tailscale serve`), and nothing saved to disk.
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	# The service name, on Compose's private network.
	handle /api/* {
		reverse_proxy family-hq:3000
	}

	# Vite puts a hash of the contents in these names, so they never change.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is a page of the app: the file if it exists, otherwise
	# index.html, and React Router works out the page from the address.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
