# Copy to `.env` next to compose.yaml on the server, and fill in.
# Generate fresh values for the server rather than reusing your laptop's.

# Login for GOWA's web UI and REST API, as user:password. The admin
# dashboard uses the same login.
# e.g. admin:<output of `openssl rand -hex 16`>
GOWA_BASIC_AUTH=admin:change-me

# Shared secret GOWA signs webhooks with; family-hq checks it.
# Generate with: openssl rand -hex 32
GOWA_WEBHOOK_SECRET=change-me

# Which family-hq version to run (a tag on Docker Hub). Pin a version
# like 0.4.2 so `docker compose pull` only changes things when you say so.
FAMILY_HQ_TAG=0.18.0

# Where GOWA's web UI listens on the server. 127.0.0.1 = server only (use
# an SSH tunnel). 0.0.0.0 = anyone on your home network.
# GOWA_BIND=127.0.0.1

# Where the admin dashboard listens on the server. 127.0.0.1 = server only.
# 0.0.0.0 = your home network and Tailscale. It asks for GOWA_BASIC_AUTH's
# login (from 0.8.1; 0.8.0 has no password, so keep 127.0.0.1 with it).
# ADMIN_BIND=127.0.0.1

# Defaults for every chat that hasn't chosen its own settings. People
# change their own (in a DM) or their group's with `/settings ...` in
# WhatsApp; these only apply until they do. Shown values are the defaults.
# DEFAULT_PRAYER_METHOD: 3 = Muslim World League (/settings methods lists all)
# DEFAULT_PRAYER_SCHOOL: Asr time, 0 = Shafi'i, 1 = Hanafi
# DEFAULT_PRAYER_ENDING_MINUTES: the last reminder comes this long before a prayer ends
# DEFAULT_TIMEZONE=Europe/London
# DEFAULT_CITY=Milton Keynes
# DEFAULT_COUNTRY=GB
# DEFAULT_PRAYER_METHOD=3
# DEFAULT_PRAYER_SCHOOL=0
# DEFAULT_PRAYER_ENDING_MINUTES=20

# Clearing data nobody uses. After this many days without using the bot, a
# person's private lists, settings and reminders are deleted (they're warned
# in their DM 3 days before); a group nobody uses the bot in is warned, then
# the bot leaves it and deletes its lists. Groups the bot was removed from
# are deleted a day later. 0 = never clear anything. Shown is the default.
# INACTIVE_DAYS=14

# Daily backups. Each day family-hq writes a copy of the database to the
# backups volume (family-hq-2026-11-03.db) and keeps the newest BACKUP_KEEP.
# Set BACKUP_PATH to a folder on another disk to keep them off the data
# disk. Shown are the defaults (the volume, and 7 copies).
# BACKUP_PATH=/mnt/backup/family-hq
# BACKUP_KEEP=7

# How much family-hq logs. info (the default) is one line per command; debug
# also shows ordinary chat and what each command contained (list items), so
# use it only while chasing a problem. Can be set per module, e.g.
# RUST_LOG=info,family_hq::routes::webhook=debug
# RUST_LOG=info

# Push notifications through ntfy (see "Push notifications" in
# docs/DEPLOY.md). Uncomment all of these to turn them on: the profile
# starts ntfy and the Cloudflare tunnel, and the two addresses are the
# public hostnames you give the tunnel.
# COMPOSE_PROFILES=push
# CLOUDFLARED_TOKEN=
# NTFY_PUBLIC_URL=https://ntfy.example.co.uk
# PUBLIC_URL=https://fhq.example.co.uk
# Created inside the ntfy container once it's running (step 4 in DEPLOY.md).
# NTFY_TOKEN=
