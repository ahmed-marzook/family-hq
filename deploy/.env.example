# Copy to `.env` next to compose.yaml on the server, and fill in.
# Generate fresh values for the server rather than reusing your laptop's.

# Login for GOWA's web UI and REST API, as user:password.
# e.g. admin:<output of `openssl rand -hex 16`>
GOWA_BASIC_AUTH=admin:change-me

# Shared secret GOWA signs webhooks with; family-hq checks it.
# Generate with: openssl rand -hex 32
GOWA_WEBHOOK_SECRET=change-me

# Which family-hq version to run (a tag on Docker Hub). Pin a version
# like 0.2.0 so `docker compose pull` only changes things when you say so.
FAMILY_HQ_TAG=0.2.0

# Where GOWA's web UI listens on the server. 127.0.0.1 = server only (use
# an SSH tunnel). 0.0.0.0 = anyone on your home network.
# GOWA_BIND=127.0.0.1

# Defaults for every chat that hasn't chosen its own settings. People
# change their own (in a DM) or their group's with `/settings ...` in
# WhatsApp; these only apply until they do. Shown values are the defaults.
# DEFAULT_PRAYER_METHOD: 3 = Muslim World League (/settings methods lists all)
# DEFAULT_PRAYER_SCHOOL: Asr time, 0 = Shafi'i, 1 = Hanafi
# DEFAULT_PRAYER_ENDING_MINUTES: the last reminder comes this long before a prayer ends
# DEFAULT_TIMEZONE=Europe/London
# DEFAULT_CITY=Milton Keynes
# DEFAULT_COUNTRY=GB
# DEFAULT_PRAYER_METHOD=3
# DEFAULT_PRAYER_SCHOOL=0
# DEFAULT_PRAYER_ENDING_MINUTES=20
