# Copy to .env (which is git-ignored) and change the values.

# Login for GOWA's web UI and REST API, as user:password.
GOWA_BASIC_AUTH=admin:change-me

# Shared secret GOWA uses to sign webhooks (X-Hub-Signature-256 header).
# family-hq will use the same value to check them. Generate one with:
#   openssl rand -hex 32
GOWA_WEBHOOK_SECRET=change-me

# Where GOWA sends incoming messages. Default: the echo server.
# Once family-hq has its webhook (Stage 1.4), switch to:
#   http://family-hq:3000/webhook/whatsapp
# GOWA_WEBHOOK_URL=http://webhook-echo:8080/webhook/whatsapp

# Which host interface GOWA's port 3001 listens on. 127.0.0.1 = this
# machine only. Use 0.0.0.0 to open the UI from another computer on the LAN.
# GOWA_BIND=127.0.0.1

# The SQLite database. Used by `cargo run` (the default is the same) and by
# the sqlx `query!` macros, which check SQL against it while compiling.
# Docker sets its own (/data/family-hq.db), and builds from .sqlx/ instead.
DATABASE_URL=sqlite:family-hq.db

# Defaults for every chat that hasn't chosen its own settings. People
# change their own (in a DM) or their group's with `/settings ...` in
# WhatsApp; these only apply until they do. Shown values are the defaults.
# DEFAULT_PRAYER_METHOD: 3 = Muslim World League (/settings methods lists all)
# DEFAULT_PRAYER_SCHOOL: Asr time, 0 = Shafi'i, 1 = Hanafi
# DEFAULT_PRAYER_ENDING_MINUTES: the last reminder comes this long before a prayer ends
# DEFAULT_TIMEZONE=Europe/London
# DEFAULT_CITY=Milton Keynes
# DEFAULT_COUNTRY=GB
# DEFAULT_PRAYER_METHOD=3
# DEFAULT_PRAYER_SCHOOL=0
# DEFAULT_PRAYER_ENDING_MINUTES=20
